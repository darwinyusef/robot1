# Copiar a .env (esta en .gitignore). El mismo HUB_TOKEN va en secrets.h del ESP32 y en el visor.
HUB_TOKEN=cambia-esto-por-algo-largo
DOMAIN=brazo.ejemplo.com
# Puente MQTT opcional (MQTT_HOST vacio = desactivado; "mosquitto" = broker local del compose, perfil mqtt)
MQTT_HOST=
MQTT_USER=
MQTT_PASS=
MQTT_BASE=brazo_v2
# MQTT_TRANSPORT=websockets   # para brokers detras de wss:// (p. ej. mqtt.aquicreamos.com: MQTT_HOST=mqtt.aquicreamos.com, puerto 443)
# ZONE_ANIMS=A=joints,B=pick,C=wave,D=circles,E=scan,F=mech
